# The admin credential, optionally supplied by this proxy. Orion 2.0 guards
# /api/v2/admin/* and /metrics with admin_auth (required in production). When
# ORION_ADMIN_AUTHORIZATION is set to the whole header value ("Bearer <key>"),
# a request that carries no Authorization of its own is sent upstream with it;
# one that carries its own (a key typed into the console) keeps it. Unset (the
# default), nothing is added and the console asks each user for a key.
#
# Anyone who can reach this UI then acts with that key: put the UI behind your
# own sign-in (an SSO proxy, a VPN) before setting it, and prefer a read-only
# key where the console only needs to look.
map $http_authorization $orion_authorization {
    ""      "${ORION_ADMIN_AUTHORIZATION}";
    default $http_authorization;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff2;

    # Nginx-level health check (does not depend on backend)
    location = /_health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Hashed static assets — immutable cache (Vite adds content hashes)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # The data plane: channels are called the way their own callers call them,
    # so the injected admin credential never goes here — it would leak to the
    # channel and stand in for (or clash with) the channel's own auth.
    location /api/v2/data/ {
        proxy_pass ${ORION_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy: API calls to Orion backend
    location /api/ {
        proxy_pass ${ORION_URL};
        proxy_set_header Authorization $orion_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy: health/readiness/metrics endpoints
    location /health {
        proxy_pass ${ORION_URL};
        # Answers anyone; adds its admin-only detail for a valid key.
        proxy_set_header Authorization $orion_authorization;
    }

    location /healthz {
        proxy_pass ${ORION_URL};
    }

    location /readyz {
        proxy_pass ${ORION_URL};
    }

    location /metrics {
        proxy_pass ${ORION_URL};
        proxy_set_header Authorization $orion_authorization;
    }

    # SPA fallback — all other routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;

        # index.html should not be cached aggressively
        location = /index.html {
            add_header Cache-Control "no-cache";
        }
    }
}
